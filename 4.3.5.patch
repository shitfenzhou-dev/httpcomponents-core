+    private static long saturatedAdd(final AtomicLong field, final long increment) {
+        while (true) {
+            final long current = field.get();
+            if (current == Long.MAX_VALUE) {
+                return Long.MAX_VALUE;
+            }
+            final long next;
+            if (current > Long.MAX_VALUE - increment) {
+                next = Long.MAX_VALUE;
+            } else {
+                next = current + increment;
+            }
+            if (field.compareAndSet(current, next)) {
+                return next;
+            }
+        }
+    }
+
+    private boolean tryDecrementRequests() {
+        while (true) {
+            final long current = requests.get();
+            if (current >= Long.MAX_VALUE || current <= 0) {
+                return false;
+            }
+            if (requests.compareAndSet(current, current - 1)) {
+                return true;
+            }
+        }
+    }
